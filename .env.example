# Copy to .env and fill in. .env is gitignored; this file is committed.
# src/config/env.validation.ts checks every value at startup.

NODE_ENV=development
PORT=5000

# App connection. A pooled URL is fine here, e.g. Neon's "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Database connections per API instance; instances × this must stay under the database limit.
DATABASE_POOL_SIZE=10
# Direct (non-pooled) connection, used by Prisma Migrate. Falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Platform: stores live at <slug>.PLATFORM_DOMAIN or on their own verified domains.
PLATFORM_DOMAIN=myplatform.com
# Comma-separated origins allowed besides the store domains, e.g. local frontends.
CORS_EXTRA_ORIGINS=http://localhost:3000
# Express "trust proxy" when behind a load balancer or a frontend server that forwards the
# shopper's IP (X-Forwarded-For), e.g. 1. Rate limits and session IPs depend on it.
# TRUST_PROXY=1

# Auth. At least 32 random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Platform routes (opening and suspending stores) need this in the X-Platform-Key header.
# Leave it out to switch those routes off. At least 32 characters.
PLATFORM_API_KEY=

# Seed (npm run db:seed): the NextPower owner account.
SEED_OWNER_PHONE=+8801XXXXXXXXX
SEED_OWNER_NAME=Store owner
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
